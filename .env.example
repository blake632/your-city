# Copy to .env for running on your own computer, or set these as Railway variables.
CITY_PASSWORD=
ANTHROPIC_API_KEY=
# Railway: ${{Postgres.DATABASE_URL}}. Leave empty on your computer to save to data/city.json.
DATABASE_URL=
# From your Google OAuth client (SETUP.md step 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only if the city cannot work out its own address (Railway sets RAILWAY_PUBLIC_DOMAIN by itself)
PUBLIC_URL=
